# 换行符按类型钉死，避免在不同机器上整文件变脏
* text=auto

# Windows 批处理必须 CRLF，Linux 脚本必须 LF
*.bat text eol=crlf
*.sh  text eol=lf

# 源码与配置统一 LF（打进 jar 的前端件也是 LF）
*.java text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.sql  text eol=lf
*.dot  text eol=lf

*.md text

*.png binary
*.jpg binary
*.jar binary
*.gz  binary
